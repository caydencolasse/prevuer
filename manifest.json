{
  "manifest_version": 3,
  "name": "prevueR",
  "short_name": "prevueR",
  "version": "1.1.0",
  "description": "Preview movies, series, TV shows, events and games: an AI summary plus trailers and clips for anything you search.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "prevueR",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Open prevueR"
    }
  },
  "permissions": ["storage", "activeTab", "scripting", "declarativeNetRequest"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.llama.com/*",
    "https://www.googleapis.com/*",
    "https://api.trakt.tv/*",
    "https://www.youtube-nocookie.com/*",
    "https://www.youtube.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://i.ytimg.com data:; frame-src https://www.youtube-nocookie.com https://www.youtube.com"
  }
}
